# All variables are optional. Only VITE_* values are exposed to the browser,
# so never put tokens, admin keys or service-role keys here.

# Public site origin used for canonical URLs, sitemap and Open Graph tags.
VITE_SITE_URL=https://worldstream-tv.pages.dev

# Base path. "/" for root deployments, "/worldstream-tv/" for GitHub project pages.
VITE_BASE=/

# Repository used for "Report a problem" / copyright removal links.
VITE_REPO_URL=https://github.com/your-org/worldstream-tv

# Optional contact address shown on the legal page for removal requests.
# VITE_CONTACT_EMAIL=copyright@example.org

# Optional, future cross-device sync. Never required for browsing, favorites or playback.
# Only the public anon key may be used client-side, with row-level security enabled.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
