{
  "name": "worldstream-tv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WorldStream TV - a worldwide directory of authorized free live TV, sports and IPTV streams.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run generate:catalog && vite",
    "build": "npm run generate:catalog && tsc -b && vite build && npm run prerender",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync:catalog": "tsx scripts/sync-playlists.ts",
    "sync:epg": "tsx scripts/sync-epg.ts",
    "validate:streams": "tsx scripts/validate-streams.ts",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "prerender": "tsx scripts/prerender.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "security:audit": "npm audit --audit-level=high",
    "test:e2e:full": "npm run build && playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-virtual": "^3.10.8",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
